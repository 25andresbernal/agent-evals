# agent-evals runs fully offline by default, using FakeJudge for the
# llm_judge scorer. Nothing below is required for the test suite, the
# quick start, or the committed example.
#
# Set this only if you want AnthropicJudge to score quality with a real
# Claude model instead of the offline FakeJudge. Get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
